# API server, used by Vite proxy locally
PORT=10000
FRONTEND_ORIGIN=http://localhost:5173
# Keep disabled until Python, FFmpeg and models are installed.
PROCESSING_ENABLED=false
YOUTUBE_IMPORT_ENABLED=false
PYTHON_BIN=python3
PROCESSING_DIR=./processing-data
# Exact trusted public HTTPS hosts only. Never add internal hosts.
AUDIO_SOURCE_HOSTS=
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
